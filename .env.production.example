DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"
NEXTAUTH_URL="https://ultimate-cs-career-architect.vercel.app"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"

# Career Architect Agent Feature Flag (set to true to enable agentic workflows)
CAREER_AGENT_ENABLED="true"

# At least one AI provider key is required.
GEMINI_API_KEY="replace-with-google-ai-studio-key"
